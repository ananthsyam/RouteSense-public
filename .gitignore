# =============================================================================
# RouteSense .gitignore
# Secrets, large local datasets and caches are never committed. The schema,
# SQL coursework, synthetic data and scripts *are* committed (see the "not
# ignored" notes below) because they make the project reproducible.
# =============================================================================

# --- Secrets and local configuration -----------------------------------------
.env
.env.*
!.env.example
*_target.env
*.local.env
.streamlit/secrets.toml

# --- Python caches / build artefacts -----------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Virtual environments ----------------------------------------------------
venv/
.venv/
env/
ENV/

# --- Certificates and database dumps (never publish) -------------------------
# NOTE: the Aiven CA is harmless but is a deployment artefact; keep it local.
*.pem
*.key
*.crt
*.p12
*.dump
*.bson
*.gz
*.zip
*_dump.sql
*backup*.sql
sql/delivery_db_backup.sql

# --- Large local-only datasets (not redistributed; see data/README.md) --------
data/raw/
data/cleaned/
data/analytics/
mongodb/
# (data/README.md, data/manifest.json, data/synthetic/ and data/demo/ ARE
#  committed on purpose.)

# --- Local-only tooling that references private infrastructure ---------------
# Not published: one-off Railway/Aiven migration and repair scripts that target
# a live deployment. See docs/EXCLUDED_ASSETS.md.
check_counts.py
import_backup.py
import_railway.py
migrate_data.py
migrate_schema.py
repair_attempt_status.py
restore_attempts.py
src/analytics.py
Procfile
*.exe

# --- Runtime output ----------------------------------------------------------
*.log
*.out
nohup.out

# --- IDE / OS junk -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
